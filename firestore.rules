rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function okProfile(d) {
      return d.keys().hasOnly(['user', 'key', 'lp', 'w', 'l', 'hist', 'solo', 'team', 'id', 'created', 'ts'])
        && d.user is string && d.user.size() >= 3 && d.user.size() <= 16
        && d.key is string && d.key.size() <= 16
        && d.lp is number && d.lp >= 0 && d.lp <= 6000
        && d.w is int && d.l is int && d.w >= 0 && d.l >= 0
        && d.hist is list && d.hist.size() <= 30
        && d.ts == request.time;
    }
    // kullanıcı adı rezervasyonu: bir kez alınır, değiştirilemez
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && name.size() >= 3 && name.size() <= 16;
    }
    match /users/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && okProfile(request.resource.data)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.key)).data.uid == uid
        && request.resource.data.lp <= 2400
        && request.resource.data.w + request.resource.data.l <= 500;
      allow update: if request.auth != null && request.auth.uid == uid
        && okProfile(request.resource.data)
        && request.resource.data.user == resource.data.user
        && request.resource.data.key == resource.data.key
        && request.resource.data.created == resource.data.created
        && (
          (request.resource.data.lp == resource.data.lp
            && request.resource.data.w == resource.data.w
            && request.resource.data.l == resource.data.l)
          || (math.abs(request.resource.data.lp - resource.data.lp) <= 40
            && request.resource.data.w >= resource.data.w
            && request.resource.data.l >= resource.data.l
            && request.resource.data.w + request.resource.data.l == resource.data.w + resource.data.l + 1
            && request.time > resource.data.ts + duration.value(45, 's'))
        );
    }
  }
}
